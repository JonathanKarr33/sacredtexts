# multibrowser reads the tradition corpus from GitHub at runtime (no secret/token — a client app
# can't keep one safe). The /review workspace additionally talks to the review API (apps/api) for
# authenticated reviewer drafts. All config is build-time (Vite `VITE_*`), baked into the bundle.

# Which repo/ref to read traditions/ from.
VITE_MULTIBENCH_REPO=faithfamilytechnologynetwork/multibench
VITE_MULTIBENCH_REF=main

# Base URL of the review API (apps/api). LEAVE EMPTY: in production this service's own edge server
# (server/index.mjs) reverse-proxies `/api/*` to the API over Railway's private network, so review
# requests are SAME-ORIGIN. An empty base means the client calls `/api/...` on this origin — exactly
# what the proxy serves. (Only set a full URL if you deliberately point the SPA at a separate,
# publicly-exposed API origin — the old cross-site topology, retired 2026-08-16.)
VITE_API_BASE=

# The API origin the edge server (server/index.mjs) forwards `/api/*` to. RUNTIME (not VITE_) — read
# by the Node server, not baked into the browser bundle. Defaults to the private service name below;
# override only if the API service is renamed or its internal port changes.
# API_ORIGIN=http://multibench-api.railway.internal:8080

# How often the browser polls GitHub for a new commit SHA (ms). The default (5 min) is
# deliberately conservative: GitHub's unauthenticated limit is 60 req/hr per IP and may be
# SHARED across users behind one NAT, so we poll gently and rely on focus/reconnect refetch
# for snappier updates. Only the SHA poll + the one tree call are on-budget; all file content
# is fetched via raw.githubusercontent.com, which is off the API rate budget.
VITE_SHA_POLL_MS=300000
